# Stage 1: Build the Next.js application
FROM node:20-slim AS builder

WORKDIR /app

# Copy package management files
COPY package.json pnpm-lock.yaml ./

# Install dependencies and build Next.js application
RUN corepack enable && corepack prepare pnpm@10.30.3 --activate
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm run build

# Stage 2: Target Rocky Linux / CentOS Stream bootc system image
FROM quay.io/centos-bootc/centos-bootc:stream9

# Wi-Fi credential build arguments
ARG WIFI_SSID=""
ARG WIFI_PASSWORD=""

# Install Node.js LTS runtime, Chromium browser, X11 server, unclutter, essential fonts, and NetworkManager Wi-Fi support
RUN dnf -y install epel-release && \
    dnf -y install \
      nodejs \
      npm \
      chromium \
      xorg-x11-server-Xorg \
      xorg-x11-xinit \
      unclutter-xfixes \
      google-noto-sans-fonts \
      dejavu-sans-fonts \
      NetworkManager-wifi \
      wpa_supplicant \
    && dnf clean all

# Ensure chromium-browser and unclutter binary links exist
RUN if [ ! -f /usr/bin/chromium-browser ] && [ -f /usr/bin/chromium ]; then \
      ln -s /usr/bin/chromium /usr/bin/chromium-browser; \
    fi && \
    if [ ! -f /usr/bin/unclutter ] && [ -f /usr/bin/unclutter-xfixes ]; then \
      ln -s /usr/bin/unclutter-xfixes /usr/bin/unclutter; \
    fi

# Configure NetworkManager Wi-Fi connection if WIFI_SSID build argument is supplied
RUN if [ -n "$WIFI_SSID" ]; then \
      mkdir -p /etc/NetworkManager/system-connections/ && \
      printf '[connection]\nid=wifi-connection\ntype=wifi\nautoconnect=true\n\n[wifi]\nmode=infrastructure\nssid=%s\n\n[wifi-security]\nkey-mgmt=wpa-psk\npsk=%s\n\n[ipv4]\nmethod=auto\n\n[ipv6]\nmethod=auto\n' "$WIFI_SSID" "$WIFI_PASSWORD" > /etc/NetworkManager/system-connections/wifi.nmconnection && \
      chmod 0600 /etc/NetworkManager/system-connections/wifi.nmconnection ; \
    fi

WORKDIR /opt/dashboard

# Copy pre-built Next.js production assets and node_modules from stage 1
COPY --from=builder /app/.next /opt/dashboard/.next
COPY --from=builder /app/public /opt/dashboard/public
COPY --from=builder /app/package.json /opt/dashboard/package.json
COPY --from=builder /app/node_modules /opt/dashboard/node_modules

# Copy kiosk launch script and set executable permissions
COPY bootc/scripts/launch-kiosk.sh /opt/dashboard/scripts/launch-kiosk.sh
RUN chmod +x /opt/dashboard/scripts/launch-kiosk.sh

# Copy systemd unit files and enable them
COPY bootc/systemd/dashboard-nextjs.service /etc/systemd/system/dashboard-nextjs.service
COPY bootc/systemd/kiosk.service /etc/systemd/system/kiosk.service
RUN systemctl enable dashboard-nextjs.service kiosk.service
